TZ=Asia/Seoul

APP_IMAGE=kosw006/trader-backend:prod
FRONT_IMAGE=kosw006/trader-frontend:prod
SPRING_PROFILES_ACTIVE=prod

POSTGRES_DB=trader
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}

#HIKARI_CONNECTION_TIMEOUT=5000
HIKARI_CONNECTION_TIMEOUT=3000
HIKARI_MAX_LIFETIME=1800000
HIKARI_IDLE_TIMEOUT=30000
HIKARI_MAX_POOL_SIZE=4
HIKARI_MIN_IDLE=2

#TOMCAT_THREADS_MAX=4
TOMCAT_THREADS_MAX=20
TOMCAT_THREADS_MIN_SPARE=2

INSTANCE_ID=${INSTANCE_ID}
EC2_PUBLIC_IP=${EC2_PUBLIC_IP}
LOKI_HOST=http://${LOKI_HOST}:3100
EUREKA_SERVER_URL=http://${EUREKA_HOST}:8761/eureka/
SPRING_REDIS_HOST=${REDIS_HOST}
SPRING_REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=${KAFKA_HOST}:9092
CORS_ALLOWED_ORIGINS=__FRONTEND_ORIGIN__,http://localhost:*,http://${EC2_PUBLIC_IP}:*

# relay 설정 — 테스트 시나리오마다 변경
# 시나리오 3 (gRPC relay): GRPC=true, HTTP=false
# 시나리오 4 (HTTP relay): GRPC=false, HTTP=true
# 시나리오 5 (drop):       GRPC=false, HTTP=false
REALTIME_GRPC_ENABLED=true
REALTIME_HTTP_ENABLED=false
# Volatile relay 경로 (redis | grpc | http)
REALTIME_VOLATILE_ROUTE_MODE=redis

REALTIME_REDIS_PUBSUB_ENABLED=true
REALTIME_KAFKA_ENABLED=true
REALTIME_REDIS_PUBSUB_ENABLED2=true
REALTIME_KAFKA_ENABLED2=true

EDIT_SESSION_FALLBACK_MODE=db
CANVAS_LOCK_CLEANUP_DELAY_MS=30000
REALTIME_HEALTH_CHECK_DELAY_MS=5000

REALTIME_GRPC_TARGET=static://${PEER_IP}:9090
REALTIME_HTTP_TARGET=http://${PEER_IP}:8080
REALTIME_HTTP_HEALTH_URL=http://${PEER_IP}:8080/internal/health
