# Docker image
CONTROLLER_IMAGE=${CONTROLLER_IMAGE}

# HTTP
HTTP_ADDR=:8090
CONTROLLER_HTTP_PORT=8090

# Database
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/trader?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Admin auth
ADMIN_API_KEY=${ADMIN_API_KEY}
ADMIN_USERNAME=${ADMIN_USERNAME}
ADMIN_PASSWORD_HASH=${ADMIN_PASSWORD_HASH}
ADMIN_SESSION_TTL=8h
ADMIN_COOKIE_SECURE=false

# Scheduler and managed workers
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=10s
SCHEDULER_BATCH_SIZE=20
WORKER_MANAGER_ENABLED=true
WORKER_POLL_INTERVAL=5s
WORKER_LEASE_TTL=30s
WORKER_JOB_BATCH_SIZE=100

# Kafka
KAFKA_BROKERS=${KAFKA_HOST}:9092
KAFKA_TOPIC=trader.jobs.events
KAFKA_CONSUMER_GROUP=trader-data-workers
KAFKA_LAG_THRESHOLD=1000
KAFKA_ALLOW_AUTO_TOPIC_CREATION=false

KAFKA_RAW_BLS_TOPIC=trader.raw.bls.ready
KAFKA_RAW_BLS_GROUP_ID=trader-data-bls-etl
KAFKA_RAW_KIS_TOPIC=trader.raw.kis.ready
KAFKA_RAW_KIS_GROUP_ID=trader-data-kis-etl
KAFKA_RAW_SEC_TOPIC=trader.raw.sec.ready
KAFKA_RAW_SEC_GROUP_ID=trader-data-sec-etl
KAFKA_RAW_NEWS_TOPIC=trader.raw.news.ready
KAFKA_RAW_NEWS_GROUP_ID=trader-data-news-etl

# Outbox relay
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=5s
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_HEALTH_TIMEOUT=3s
OUTBOX_STALE_AFTER=5m
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY=10s
OUTBOX_RETRY_MAX_DELAY=5m

# AWS ASG actuator
AWS_CLI_PATH=aws
AWS_REGION=${AWS_REGION}

# Shutdown
SHUTDOWN_TIMEOUT=10s

