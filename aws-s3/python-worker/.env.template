# Docker image
WORKER_IMAGE=${WORKER_IMAGE}

# Database
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/trader?sslmode=disable

# Controller callback for RAW_OBJECT_READY and worker heartbeat
TRADER_CONTROLLER_URL=http://${CONTROLLER_HOST}:8090
ADMIN_API_KEY=${ADMIN_API_KEY}

# Kafka
KAFKA_BROKERS=${KAFKA_HOST}:9092

# JOB_ITEM_QUEUED consumer
KAFKA_TOPIC=trader.jobs.events
KAFKA_GROUP_ID=trader-data-workers
KAFKA_CONSUMER_NAME=trader-data-worker

# RAW_OBJECT_READY ETL consumers
KAFKA_RAW_BLS_TOPIC=trader.raw.bls.ready
KAFKA_RAW_BLS_GROUP_ID=trader-data-bls-etl
KAFKA_RAW_BLS_CONSUMER_NAME=bls-macro-etl-worker

KAFKA_RAW_KIS_TOPIC=trader.raw.kis.ready
KAFKA_RAW_KIS_GROUP_ID=trader-data-kis-etl
KAFKA_RAW_KIS_CONSUMER_NAME=kis-price-etl-worker

KAFKA_RAW_SEC_TOPIC=trader.raw.sec.ready
KAFKA_RAW_SEC_GROUP_ID=trader-data-sec-etl
KAFKA_RAW_SEC_CONSUMER_NAME=sec-financial-etl-worker

# Worker identity and heartbeat
WORKER_TARGET_KEY=python-worker-node
WORKER_NODE_NAME=${WORKER_NODE_NAME}
WORKER_HEARTBEAT_ENABLED=true
WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# Raw storage
RAW_STORAGE_BACKEND=LOCAL
RAW_STORAGE_LOCAL_ROOT=pipeline_output
RAW_STORAGE_BASE_URI=

# Optional external API credentials
APPKEY=${APPKEY}
APPSECRET=${APPSECRET}
ACCESS_TOKEN=${ACCESS_TOKEN}
ACCESS_TOKEN_TOKEN_EXPIRED=${ACCESS_TOKEN_TOKEN_EXPIRED}
BLS_API_KEY=${BLS_API_KEY}
SEC_USER_AGENT=${SEC_USER_AGENT}

PYTHONUNBUFFERED=1
PYTHONPATH=/app
