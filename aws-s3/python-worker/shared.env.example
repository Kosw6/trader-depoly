# Supply secrets through a private mode-0600 generated env file, never this file.
DATABASE_URL=
TRADER_CONTROLLER_URL=
ADMIN_API_KEY=
KAFKA_BROKERS=
KAFKA_TOPIC=trader.jobs.events
# Keep the actual existing group and ledger consumer identity during migration.
# Change node identity only; a new group would replay earlier offsets.
KAFKA_GROUP_ID=trader-data-workers
KAFKA_CONSUMER_NAME=trader-data-worker
# Existing logical target keeps the heartbeat foreign-key contract; the Go
# shared-host mode disables capacity planners/actuators for this deployment.
WORKER_TARGET_KEY=python-worker-node
WORKER_NODE_NAME=shared-index-collector
WORKER_HEARTBEAT_ENABLED=true
RAW_STORAGE_BACKEND=S3
RAW_STORAGE_LOCAL_ROOT=pipeline_output
RAW_STORAGE_BASE_URI=s3://kosw-db-migration-2026/collections/shared646/raw
RAW_MAX_OBJECT_BYTES=33554432
AWS_DEFAULT_REGION=ap-northeast-2
PYTHONUNBUFFERED=1
PYTHONPATH=/app
PYTHONDONTWRITEBYTECODE=1
